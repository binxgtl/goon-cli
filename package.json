{
  "name": "goon-cli",
  "version": "0.3.3",
  "description": "A small independent coding harness for Termux and external model APIs",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "goon": "bin/goon.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "docs",
    "scripts",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests bin scripts",
    "test": "npm run build && node --test --test-concurrency=4 \"tests/*.test.mjs\"",
    "test:e2e": "npm run build && node --test --test-concurrency=4 \"tests/e2e/*.test.mjs\"",
    "test:one": "npm run build && node --test",
    "check": "npm run lint && npm run build && node --test --test-concurrency=4 \"tests/*.test.mjs\" \"tests/e2e/*.test.mjs\"",
    "watch": "tsc --watch --preserveWatchOutput",
    "dev": "npm run build && node bin/goon.mjs",
    "prepack": "npm run build",
    "release:pack": "node scripts/pack-release.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.135",
    "@ai-sdk/openai": "3.0.131",
    "@ai-sdk/openai-compatible": "2.0.87",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ai": "6.0.312",
    "ajv": "8.20.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.57.0",
    "typescript": "~5.9.3"
  }
}
