{
  "name": "goon-cli",
  "version": "0.2.23",
  "description": "A small independent coding harness for Termux and external model APIs",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "goon": "bin/goon.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "docs",
    "scripts",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests bin scripts",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "release:pack": "node scripts/pack-release.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.81",
    "@ai-sdk/openai": "3.0.58",
    "@ai-sdk/openai-compatible": "2.0.60",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ai": "6.0.193",
    "ajv": "8.17.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.57.0",
    "typescript": "~5.9.3"
  }
}
