{
  "name": "@binxgodteli/goon-cli",
  "version": "0.3.14",
  "description": "A small independent coding harness for Termux and external model APIs",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/binxgtl/goon-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binxgtl/goon-cli.git"
  },
  "bugs": {
    "url": "https://github.com/binxgtl/goon-cli/issues"
  },
  "keywords": [
    "coding-agent",
    "cli",
    "termux",
    "llm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "goon": "bin/goon.mjs"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "files": [
    "bin",
    "scripts/install.mjs",
    "vendor/manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt",
    "NOTICE.md"
  ],
  "scripts": {
    "postinstall": "node scripts/install.mjs",
    "prepublishOnly": "node scripts/pack-release.mjs --verify-ready",
    "build": "cargo build",
    "build:release": "cargo build --release",
    "lint": "cargo fmt --check && cargo clippy --all-targets --locked -- -D warnings && oxlint tests bin scripts",
    "test": "cargo build --locked && node --test --test-concurrency=4 \"tests/*.test.mjs\"",
    "test:rust": "cargo test --locked",
    "test:e2e": "cargo build --locked && node --test --test-concurrency=4 \"tests/e2e/*.test.mjs\"",
    "test:one": "cargo build --locked && node --test",
    "check": "npm run lint && cargo test --locked && node --test --test-concurrency=4 \"tests/*.test.mjs\" \"tests/e2e/*.test.mjs\"",
    "dev": "cargo build --locked && node bin/goon.mjs",
    "release:pack": "node scripts/pack-release.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "oxlint": "^1.57.0"
  }
}
